{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guardrails.sh",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking guardrails"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.uat)",
      "Read(./.env.production)",
      "Read(./.env.test)"
    ],
    "deny": [
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.staging)",
      "Edit(./.env.uat)",
      "Edit(./.env.production)",
      "Edit(./.env.test)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
