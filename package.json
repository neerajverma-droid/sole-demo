{
  "name": "sole-b2c-frontend",
  "version": "2.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .next dist",
    "clean:node_modules": "rm -rf .next dist node_modules",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:watch": "vitest",
    "test:new": "vitest run tests",
    "pretest:report": "node -e \"require('fs').rmSync('test-report',{recursive:true,force:true})\"",
    "test:report": "vitest run --reporter=default --reporter=json --reporter=html --outputFile.json=test-report/results.json --outputFile.html=test-report/ui/index.html; node scripts/test-report.mjs",
    "test:report:open": "open test-report/index.html",
    "test:report:ui": "vite preview --outDir test-report/ui",
    "test:ui": "vitest --ui"
  },
